{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "type": "string"
    },
    "edge_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "blocked",
        "open",
        "unknown"
      ],
      "type": "string"
    },
    "confirmation": {
      "enum": [
        "confirmed",
        "unconfirmed"
      ],
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewer_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_uri": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "edge_id",
    "status",
    "confirmation",
    "source",
    "observed_at",
    "updated_at",
    "expires_at",
    "reviewer_id",
    "evidence_uri",
    "confidence",
    "notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-image.local/schemas/v2/road-state-record.schema.json",
  "title": "RoadStateRecord"
}
