{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "type": "string"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "acquired_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_reference_system": {
      "type": "string",
      "minLength": 1
    },
    "pixel_size_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "footprint": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_type": {
      "enum": [
        "satellite",
        "uav_orthomosaic",
        "public_orthomosaic"
      ],
      "type": "string"
    },
    "is_substitute": {
      "type": "boolean"
    },
    "quality_notes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "path",
    "acquired_at",
    "source",
    "coordinate_reference_system",
    "pixel_size_m",
    "bands",
    "footprint",
    "source_type",
    "is_substitute",
    "quality_notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-image.local/schemas/v2/raster-asset.schema.json",
  "title": "RasterAsset"
}
