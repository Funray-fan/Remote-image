{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "warning",
        "fail"
      ],
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CheckItem"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {}
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "applicability": {
      "enum": [
        "applicable",
        "not_applicable",
        "unknown"
      ],
      "type": "string"
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "status",
    "checks",
    "metrics",
    "warnings",
    "artifacts",
    "applicability",
    "model_name",
    "model_version",
    "asset_id"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-image.local/schemas/v2/applicability-report.schema.json",
  "title": "ApplicabilityReport",
  "$defs": {
    "CheckItem": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "fail"
          ],
          "type": "string"
        },
        "expected": {},
        "actual": {},
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "status",
        "expected",
        "actual",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
