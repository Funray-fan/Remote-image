{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "study_area": {
      "$ref": "#/$defs/StudyArea"
    },
    "post_event": {
      "$ref": "#/$defs/RasterAsset"
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "pre_event": {
      "anyOf": [
        {
          "$ref": "#/$defs/RasterAsset"
        },
        {
          "type": "null"
        }
      ]
    },
    "building_footprints": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "task": {
      "enum": [
        "building_damage",
        "building_segmentation"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "study_area",
    "post_event",
    "model_name",
    "model_version",
    "pre_event",
    "building_footprints",
    "task"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-image.local/schemas/v2/damage-request.schema.json",
  "title": "DamageRequest",
  "$defs": {
    "StudyArea": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_reference_system": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "identifier",
        "boundary",
        "coordinate_reference_system"
      ],
      "additionalProperties": false
    },
    "RasterAsset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "acquired_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_reference_system": {
          "type": "string",
          "minLength": 1
        },
        "pixel_size_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "footprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_type": {
          "enum": [
            "satellite",
            "uav_orthomosaic",
            "public_orthomosaic"
          ],
          "type": "string"
        },
        "is_substitute": {
          "type": "boolean"
        },
        "quality_notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "asset_id",
        "path",
        "acquired_at",
        "source",
        "coordinate_reference_system",
        "pixel_size_m",
        "bands",
        "footprint",
        "source_type",
        "is_substitute",
        "quality_notes"
      ],
      "additionalProperties": false
    }
  }
}
