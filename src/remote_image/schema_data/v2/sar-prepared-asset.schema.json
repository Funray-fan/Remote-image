{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "type": "string"
    },
    "asset": {
      "$ref": "#/$defs/RasterAsset"
    },
    "record": {
      "$ref": "#/$defs/AssetRecord"
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    },
    "backscatter_quantity": {
      "enum": [
        "sigma0"
      ],
      "type": "string"
    },
    "value_scale": {
      "enum": [
        "db"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "asset",
    "record",
    "report_path",
    "backscatter_quantity",
    "value_scale"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-image.local/schemas/v2/sar-prepared-asset.schema.json",
  "title": "SARPreparedAsset",
  "$defs": {
    "RasterAsset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "acquired_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_reference_system": {
          "type": "string",
          "minLength": 1
        },
        "pixel_size_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "footprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_type": {
          "enum": [
            "satellite",
            "uav_orthomosaic",
            "public_orthomosaic"
          ],
          "type": "string"
        },
        "is_substitute": {
          "type": "boolean"
        },
        "quality_notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "asset_id",
        "path",
        "acquired_at",
        "source",
        "coordinate_reference_system",
        "pixel_size_m",
        "bands",
        "footprint",
        "source_type",
        "is_substitute",
        "quality_notes"
      ],
      "additionalProperties": false
    },
    "AssetRecord": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "spatial_coverage": {
          "type": "string",
          "minLength": 1
        },
        "time_range": {
          "type": "array",
          "prefixItems": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "status": {
          "enum": [
            "planned",
            "verified",
            "acquired",
            "usable"
          ],
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "asset_id",
        "source_url",
        "retrieved_at",
        "license_id",
        "sha256",
        "spatial_coverage",
        "time_range",
        "status",
        "limitations"
      ],
      "additionalProperties": false
    }
  }
}
