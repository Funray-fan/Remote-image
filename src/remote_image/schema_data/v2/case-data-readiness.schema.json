{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataReadinessItem"
      }
    },
    "schema_version": {
      "const": "2.0",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "items",
    "schema_version"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-image.local/schemas/v2/case-data-readiness.schema.json",
  "title": "CaseDataReadiness",
  "$defs": {
    "DataReadinessItem": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "stage1",
            "stage2",
            "stage3"
          ],
          "type": "string"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "acquired_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "product_level": {
          "type": "string",
          "minLength": 1
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pixel_size_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "labels_available": {
          "type": "boolean"
        },
        "download_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "extracted_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "storage_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "compute_requirements": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "checker": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_uri": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "planned",
            "verified",
            "acquired",
            "usable"
          ],
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "event_id",
        "stage",
        "purpose",
        "source_url",
        "license_id",
        "acquired_at",
        "product_level",
        "bands",
        "pixel_size_m",
        "labels_available",
        "download_bytes",
        "extracted_bytes",
        "storage_path",
        "compute_requirements",
        "owner",
        "checker",
        "checked_at",
        "evidence_uri",
        "status",
        "limitations"
      ],
      "additionalProperties": false
    }
  }
}
