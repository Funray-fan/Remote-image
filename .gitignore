__pycache__/
*.py[cod]
.venv/
.env
.env.*
.idea/
.vscode/
dist/
build/
.pytest_cache/
pytest-cache-files-*/
*.egg-info/

# 大型数据、模型和运行产物只保存在本地；README/清单可提交。
data/*
!data/README.md
!data/manifests/
!data/manifests/**
outputs/*
!outputs/README.md
models/*
!models/README.md
!models/manifests/
!models/manifests/**

*.tif
*.tiff
*.geojson
*.gpkg
*.onnx
*.pt
*.pth
*.ckpt
*.kml
*.vrt
*.aux.xml
*.log
Thumbs.db
.DS_Store

# 覆盖全局地理文件忽略规则：只允许小型测试 fixture 和数据清单入库。
!tests/fixtures/**/*.geojson
!tests/fixtures/**/*.gpkg
!tests/fixtures/**/*.tif
!tests/fixtures/**/*.tiff
!data/manifests/**/*.geojson

