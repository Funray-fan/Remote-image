{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "study_area": {
      "$ref": "#/$defs/StudyArea"
    },
    "inputs": {
      "$ref": "#/$defs/PreparedInputs"
    },
    "options": {
      "$ref": "#/$defs/FloodOptions"
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "study_area",
    "inputs",
    "options",
    "output_dir"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-image.local/schemas/v2/flood-request.schema.json",
  "title": "FloodRequest",
  "$defs": {
    "StudyArea": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_reference_system": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "identifier",
        "boundary",
        "coordinate_reference_system"
      ],
      "additionalProperties": false
    },
    "PreparedInputs": {
      "type": "object",
      "properties": {
        "pre_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/RasterAsset"
            },
            {
              "type": "null"
            }
          ]
        },
        "post_event": {
          "$ref": "#/$defs/RasterAsset"
        },
        "study_area_id": {
          "type": "string",
          "minLength": 1
        },
        "grid": {
          "$ref": "#/$defs/GridSpec"
        },
        "valid_mask": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pre_event",
        "post_event",
        "study_area_id",
        "grid",
        "valid_mask"
      ],
      "additionalProperties": false
    },
    "RasterAsset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "acquired_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_reference_system": {
          "type": "string",
          "minLength": 1
        },
        "pixel_size_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "footprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_type": {
          "enum": [
            "satellite",
            "uav_orthomosaic",
            "public_orthomosaic"
          ],
          "type": "string"
        },
        "is_substitute": {
          "type": "boolean"
        },
        "quality_notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "asset_id",
        "path",
        "acquired_at",
        "source",
        "coordinate_reference_system",
        "pixel_size_m",
        "bands",
        "footprint",
        "source_type",
        "is_substitute",
        "quality_notes"
      ],
      "additionalProperties": false
    },
    "GridSpec": {
      "type": "object",
      "properties": {
        "transform": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "pixel_size_x_m": {
          "type": "number"
        },
        "pixel_size_y_m": {
          "type": "number"
        }
      },
      "required": [
        "transform",
        "width",
        "height",
        "pixel_size_x_m",
        "pixel_size_y_m"
      ],
      "additionalProperties": false
    },
    "FloodOptions": {
      "type": "object",
      "properties": {
        "polarizations": {
          "type": "array",
          "items": {
            "enum": [
              "VV",
              "VH"
            ],
            "type": "string"
          }
        },
        "post_thresholds_db": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "pre_water_thresholds_db": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "polarization_rule": {
          "enum": [
            "single",
            "all",
            "any"
          ],
          "type": "string"
        },
        "permanent_water_mask": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "exclusion_mask": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "min_patch_area_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "enum": [
            "sar_post_threshold"
          ],
          "type": "string"
        }
      },
      "required": [
        "polarizations",
        "post_thresholds_db",
        "pre_water_thresholds_db",
        "polarization_rule",
        "permanent_water_mask",
        "exclusion_mask",
        "min_patch_area_m2",
        "method"
      ],
      "additionalProperties": false
    }
  }
}
