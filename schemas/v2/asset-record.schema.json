{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "type": "string"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieved_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "license_id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "spatial_coverage": {
      "type": "string",
      "minLength": 1
    },
    "time_range": {
      "type": "array",
      "prefixItems": [
        {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "status": {
      "enum": [
        "planned",
        "verified",
        "acquired",
        "usable"
      ],
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "source_url",
    "retrieved_at",
    "license_id",
    "sha256",
    "spatial_coverage",
    "time_range",
    "status",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-image.local/schemas/v2/asset-record.schema.json",
  "title": "AssetRecord"
}
