{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-image.local/schemas/v2/damage-vector.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "geometry",
          "properties"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "geometry": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "coordinates": {
                "type": "array"
              }
            },
            "additionalProperties": false
          },
          "properties": {
            "type": "object",
            "required": [
              "event_id",
              "study_area_id",
              "building_id",
              "damage_class",
              "confidence",
              "reason",
              "model_name",
              "model_version"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "study_area_id": {
                "type": "string",
                "minLength": 1
              },
              "building_id": {
                "type": "string",
                "minLength": 1
              },
              "damage_class": {
                "enum": [
                  "no-damage",
                  "minor-damage",
                  "major-damage",
                  "destroyed",
                  "un-classified"
                ]
              },
              "confidence": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "model_name": {
                "type": "string",
                "minLength": 1
              },
              "model_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
