{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "layers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SourceRecord"
      }
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "layers"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-image.local/schemas/v2/context-sources.schema.json",
  "title": "ContextSources",
  "$defs": {
    "SourceRecord": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "id_field": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "source",
        "date",
        "license_id",
        "id_field"
      ],
      "additionalProperties": false
    }
  }
}
