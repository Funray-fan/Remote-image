          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "uncertain_count": {
      "type": "integer"
    },
    "cost_mode": {
      "enum": [
        "distance",
        "time",
        "risk_weighted"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "meta",
    "routes_path",
    "route_count",
    "unreachable_pairs",
    "uncertain_count",
    "cost_mode"
