{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ResultMeta"
    },
    "routes_path": {
      "type": "string",
      "minLength": 1
    },
    "route_count": {
      "type": "integer"
    },
    "unreachable_pairs": {
      "type": "array",
      "items": {
        "type": "array",
