        "schema_version": {
          "enum": [
            "2.0"
          ],
          "type": "string"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "study_area_id": {
          "type": "string",
          "minLength": 1
        },
        "input_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "method_version": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {}
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "study_area_id",
        "input_asset_ids",
        "method",
        "method_version",
        "parameters",
        "created_at",
        "warnings"
      ],
      "additionalProperties": false
