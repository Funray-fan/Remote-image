{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Funray-fan/Remote-image/schemas/v1/damage-vector.schema.json",
  "title": "DamageVectorFeatureCollection",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "features"],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": {"const": "Feature"},
          "geometry": {"type": ["object", "null"]},
          "properties": {
            "type": "object",
            "additionalProperties": true,
            "required": ["building_id", "damage_class", "confidence", "event_id", "source", "model_name", "model_version"],
            "properties": {
              "building_id": {"type": "string", "minLength": 1},
              "damage_class": {"enum": ["no-damage", "minor-damage", "major-damage", "destroyed", "un-classified"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "event_id": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "model_name": {"type": "string", "minLength": 1},
              "model_version": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
