{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Funray-fan/Remote-image/schemas/v1/stage-result-manifest.schema.json",
  "title": "StageResultManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "stage",
    "created_at",
    "input_asset_ids",
    "method",
    "artifacts",
    "files",
    "warnings",
    "run_command",
    "environment",
    "tests",
    "known_limitations",
    "producer",
    "reviewer"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["stage1", "stage2", "stage3"]},
    "created_at": {"type": "string", "format": "date-time"},
    "input_asset_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "method": {"type": "string", "minLength": 1},
    "model_name": {"type": ["string", "null"]},
    "model_version": {"type": ["string", "null"]},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_or_uri", "size_bytes", "sha256"],
        "properties": {
          "path_or_uri": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "run_command": {"type": "string", "minLength": 1},
    "environment": {"type": "object", "additionalProperties": true},
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "warning", "fail", "not_run"]},
          "details": {"type": "string"}
        }
      }
    },
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "producer": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1}
  }
}
